# Copy to .env or export in your shell before starting services.
# All values below are local-only defaults that mirror the previous hardcoded values.
# Before any non-local deploy, rotate every secret and ensure the leaked values
# in git history are revoked / rotated upstream (DB users, Redis ACLs, JWT key).

# --- JPA / Hibernate ---
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# --- gRPC client (gateway) ---
GRPC_NEGOTIATION=plaintext
GRPC_CLIENT_DEADLINE=3s

# --- product-service ---
PRODUCT_DB_URL=jdbc:postgresql://localhost:7001/product_db
PRODUCT_DB_USERNAME=product-service
PRODUCT_DB_PASSWORD=product-service
PRODUCT_DB_NAME=product_db
PRODUCT_GRPC_ADDRESS=static://localhost:9001

# --- order-service ---
ORDER_DB_URL=jdbc:postgresql://localhost:7002/order_db
ORDER_DB_USERNAME=order-service
ORDER_DB_PASSWORD=order-service
ORDER_DB_NAME=order_db
ORDER_GRPC_ADDRESS=static://localhost:9002
ORDER_OUTBOX_RELAY_FIXED_DELAY_MS=5000

# --- inventory-service ---
INVENTORY_DB_URL=jdbc:postgresql://localhost:7004/inventory_db
INVENTORY_DB_USERNAME=inventory-service
INVENTORY_DB_PASSWORD=inventory-service
INVENTORY_DB_NAME=inventory_db
INVENTORY_REDIS_HOST=localhost
INVENTORY_REDIS_PORT=7005
INVENTORY_REDIS_PASSWORD=inventory-service
INVENTORY_GRPC_ADDRESS=static://localhost:9003

# --- auth-service ---
AUTH_DB_URL=jdbc:postgresql://localhost:7007/auth_db
AUTH_DB_USERNAME=auth-service
AUTH_DB_PASSWORD=auth-service
AUTH_DB_NAME=auth_db
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=7006
AUTH_REDIS_PASSWORD=auth-service
AUTH_GRPC_ADDRESS=static://localhost:9005

# JWT signing key. MUST be rotated for any non-local deploy.
# HS256 requires >= 32 bytes when using io.jsonwebtoken Keys.hmacShaKeyFor.
JWT_SECRET=dev-only-change-me-32chars-min-secret-key

# --- shared kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:7003

# --- gateway ---
GATEWAY_REDIS_HOST=localhost
GATEWAY_REDIS_PORT=7005
GATEWAY_REDIS_PASSWORD=inventory-service
GATEWAY_RL_REPLENISH=50
GATEWAY_RL_BURST=100
